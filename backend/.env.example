# NayaSetu Backend Environment Configuration
HOST=127.0.0.1
PORT=8000

# Maximum PDF upload size in bytes (default: 15 MB = 15728640 bytes)
MAX_UPLOAD_SIZE_BYTES=15728640

# Minimum characters per page to consider selectable text present without OCR requirement
OCR_THRESHOLD_CHARS=30

# Allowed CORS origins (comma-separated list for local Vite frontend)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# OCR Configuration (Tesseract OCR Engine)
# Path to Tesseract executable (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe or /usr/bin/tesseract)
# Note: Installing Python 'pytesseract' does not install the OS executable itself.
TESSERACT_CMD=

# Comma-separated or plus-separated OCR languages (default: eng)
OCR_LANGUAGES=eng

# Legal RAG & Generative Model Configuration (Optional)
# If GEMINI_API_KEY is unset, NayaSetu runs in local zero-hallucination Legal-RAG hybrid mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
LEGAL_RAG_TOP_K=3
